{"number":114,"ayahs":[{"n":1,"ar":"قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","id":"Katakanlah, \"Aku berlindung kepada Tuhannya manusia,"},{"n":2,"ar":"مَلِكِ ٱلنَّاسِ","id":"Raja manusia,"},{"n":3,"ar":"إِلَـٰهِ ٱلنَّاسِ","id":"sembahan manusia,"},{"n":4,"ar":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","id":"dari kejahatan (bisikan) setan yang bersembunyi,"},{"n":5,"ar":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","id":"yang membisikkan (kejahatan) ke dalam dada manusia,"},{"n":6,"ar":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","id":"dari (golongan) jin dan manusia.\""}]}