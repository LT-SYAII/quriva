{"number":107,"ayahs":[{"n":1,"ar":"أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","id":"Tahukah kamu (orang) yang mendustakan agama?"},{"n":2,"ar":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","id":"Maka itulah orang yang menghardik anak yatim,"},{"n":3,"ar":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","id":"dan tidak mengajak memberi makan orang miskin."},{"n":4,"ar":"فَوَيْلٌ لِّلْمُصَلِّينَ","id":"Maka celakalah orang yang salat,"},{"n":5,"ar":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","id":"(yaitu) orang-orang yang lalai terhadap salatnya,"},{"n":6,"ar":"ٱلَّذِينَ هُمْ يُرَآءُونَ","id":"yang berbuat riya`,"},{"n":7,"ar":"وَيَمْنَعُونَ ٱلْمَاعُونَ","id":"dan enggan (memberikan) bantuan."}]}